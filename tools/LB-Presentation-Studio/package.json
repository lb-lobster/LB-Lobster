{
  "name": "lb-presentation-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone, editable PPTX production pipeline with independent Codex visual skills",
  "type": "module",
  "bin": {
    "lbp": "./bin/lbp.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "node bin/lbp.mjs create examples/maillardhelp-demo.json --out dist/maillardhelp-demo.pptx --qc",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node bin/lbp.mjs doctor"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0",
    "mammoth": "^1.9.1"
  }
}
